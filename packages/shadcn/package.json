{
  "name": "@swifty.js/a2ui-shadcn",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog.js",
      "require": "./dist/catalog.cjs"
    },
    "./prompt": {
      "types": "./dist/prompt/index.d.ts",
      "import": "./dist/prompt.js",
      "require": "./dist/prompt.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode lib",
    "build:app": "tsc -b && vite build",
    "catalog": "tsx scripts/catalog.ts  --tsconfig tsconfig.node.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "shadcn": "shadcn add --all --yes"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "zod": "^3"
  },
  "dependencies": {
    "@a2ui/markdown-it": "^0.1.1",
    "@a2ui/react": "^0.10.2",
    "@a2ui/web_core": "^0.10.6",
    "@base-ui/react": "^1.7.0",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vite-plugin-dts": "^5.0.3",
    "zod-to-json-schema": "^3.25.2"
  }
}
