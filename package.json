{
  "name": "@swifty.js/a2ui",
  "version": "0.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "git:commit": "git add -A && git commit -m 'Introduce new features'",
    "git:push": "pnpm git:commit && git push origin main",
    "format:lit": "pnpm --filter @swifty.js/lit format",
    "format:react": "pnpm --filter @swifty.js/react format",
    "format:shadcn": "pnpm --filter @swifty.js/shadcn format",
    "format:server": "pnpm --filter server format",
    "format": "run-p format:*",
    "postinstall": "curl -fsSL https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json -o catalog.json",
    "prepare": "husky",
    "lit": "tsx ./start.ts lit",
    "react": "tsx ./start.ts react",
    "shadcn": "tsx ./start.ts shadcn"
  },
  "keywords": [
    "a2ui"
  ],
  "author": "https://github.com/hangtiancheng",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^24.13.3",
    "husky": "^9.1.7",
    "npm-run-all2": "^9.0.3",
    "tsx": "^4.23.12"
  }
}
